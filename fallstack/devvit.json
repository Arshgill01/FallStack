{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "fallstack",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "height": "tall",
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true
  },
  "menu": {
    "items": [
      {
        "label": "Create Fallstack daily post",
        "description": "Post today's shared cursed tower",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      }
    ]
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "fallstack_dev"
  }
}
