{
  "private": true,
  "name": "fallstack",
  "version": "0.0.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "deploy": "npm run type-check && npm run lint && devvit upload",
    "dev": "devvit playtest",
    "launch": "npm run deploy && devvit publish",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "login": "devvit login",
    "prettier": "prettier --write .",
    "qa:audio": "node scripts/qa/audio-capture.mjs",
    "qa:audio-events": "node scripts/qa/audio-events.mjs",
    "qa:audio-lifecycle": "node scripts/qa/audio-lifecycle.mjs",
    "qa:audio-palette": "node scripts/qa/audio-palette.mjs",
    "qa:playthrough": "node scripts/qa/full-playthrough.mjs",
    "qa:runtime": "node scripts/qa/runtime-smoke.mjs",
    "qa:shared": "node scripts/qa/shared-session.mjs",
    "qa:ui-readability": "node scripts/qa/ui-readability.mjs",
    "qa:world-bounds": "node scripts/qa/world-bounds.mjs",
    "test": "npm run type-check && node --test 'dist/types/shared/**/*.test.js' 'dist/types/client/**/*.test.js' 'dist/types/server/**/*.test.js'",
    "type-check": "tsc --build"
  },
  "engines": {
    "node": ">=22.2.0"
  },
  "dependencies": {
    "@devvit/start": "0.13.7",
    "@devvit/web": "0.13.7",
    "@hono/node-server": "2.0.8",
    "devvit": "0.13.7",
    "hono": "4.12.29",
    "phaser": "^4.2.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.2",
    "@types/node": "^22.19.19",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.6.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "playwright": "^1.61.1",
    "prettier": "3.9.4",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.4"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
